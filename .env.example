# Copiá este archivo a `.env` y completá con tus valores.
# (`.env` está en .gitignore: las claves no se suben al repo.)
#
# Es el bot que avisa por Telegram cuando WhatsApp se desloguea y te envía
# el QR para re-vincular el bot de forma remota.

# Token del bot que creás con @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=

# ID del chat (o grupo) donde se reciben las alertas. Se obtiene enviándole
# un mensaje al bot y consultando https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Alarma local "cliente sin respuesta": cuántos segundos esperar desde el
# welcome antes de hacer sonar sonido.mp3 (default 240 = 4 minutos).
WELCOME_ALERT_TIMEOUT=240